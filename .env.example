# PostgreSQL
POSTGRESQL_USER=zipline
POSTGRESQL_DB=zipline
POSTGRESQL_PASSWORD=change-this-to-a-long-password

# Zipline core
CORE_SECRET=replace-with-a-random-string-of-at-least-32-characters
CORE_HOSTNAME=0.0.0.0
CORE_PORT=3000
CORE_TRUST_PROXY=true
CORE_RETURN_HTTPS_URLS=true

# Storage: use "local" for the existing ./uploads volume, or "s3" for an
# AWS S3 bucket, MinIO, Cloudflare R2, or another S3-compatible service.
DATASOURCE_TYPE=local
DATASOURCE_LOCAL_DIRECTORY=/zipline/uploads

# --- AWS S3 ---
# Set DATASOURCE_TYPE=s3 and fill these values. Leave ENDPOINT empty for AWS.
# DATASOURCE_S3_ACCESS_KEY_ID=AKIA...
# DATASOURCE_S3_SECRET_ACCESS_KEY=...
# DATASOURCE_S3_BUCKET=zipline
# DATASOURCE_S3_REGION=ap-southeast-1
# DATASOURCE_S3_ENDPOINT=
# DATASOURCE_S3_FORCE_PATH_STYLE=false

# --- External MinIO / S3-compatible storage ---
# Set DATASOURCE_TYPE=s3 and fill these values. The endpoint must include its
# scheme and port. Use path-style addressing for MinIO unless your setup uses
# wildcard bucket subdomains.
# DATASOURCE_S3_ACCESS_KEY_ID=...
# DATASOURCE_S3_SECRET_ACCESS_KEY=...
# DATASOURCE_S3_BUCKET=zipline
# DATASOURCE_S3_REGION=us-east-1
# DATASOURCE_S3_ENDPOINT=https://minio.example.com
# DATASOURCE_S3_FORCE_PATH_STYLE=true
